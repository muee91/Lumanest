ARG PYTHON_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_RETRIES=5 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000

WORKDIR /app
COPY requirements.prod.txt ./
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'Acquire::Retries "5";' \
      'Acquire::ForceIPv4 "true";' \
      'Acquire::http::Timeout "60";' \
      'Acquire::https::Timeout "60";' \
      > /etc/apt/apt.conf.d/80-lumanest-network \
    && pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements.prod.txt
COPY pyproject.toml ./
RUN pip install --no-cache-dir --no-deps --no-build-isolation . \
    && python -m playwright install --with-deps chromium
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

USER nobody
CMD ["python", "-m", "app.worker"]
