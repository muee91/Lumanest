# Copy to qweather-token-broker.env and replace every placeholder locally.
# Never commit the populated environment file.

QWEATHER_KEY_ID=replace-with-qweather-credential-id
QWEATHER_PROJECT_ID=replace-with-qweather-project-id
QWEATHER_API_HOST=https://replace-with-project-host.qweatherapi.com
QWEATHER_PRIVATE_KEY_FILE=/absolute/path/to/qweather-ed25519-private.pem

LUMANEST_SERVICE_TOKEN=replace-with-random-hex-token
AMAP_WEB_KEY=replace-with-amap-web-key
LUMANEST_CONFIG_MASTER_KEY=replace-with-base64-32-byte-key
LUMANEST_ADMIN_BOOTSTRAP_PASSWORD=replace-with-first-start-password
LUMANEST_ADMIN_PASSWORD=
LUMANEST_SIMULATION_ENABLED=false
LUMANEST_DATABASE_PASSWORD=replace-with-database-password

CONTEXT_INTERNAL_TOKEN=replace-with-random-context-token
DISCOVERY_INTERNAL_TOKEN=replace-with-random-discovery-token
DISCOVERY_WORKER_TOKEN=replace-with-random-worker-token

SUNSETBOT_BASE_URL=https://sunsetbot.top
SEVEN_TIMER_BASE_URL=https://www.7timer.info
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com

# Private VIIRS and DEM services. Both dataset revisions must exactly match the
# service responses so the Broker refuses an accidental stale raster switch.
VIIRS_RASTER_HOST_DIR=/absolute/path/to/viirs
VIIRS_RASTER_PATH=/data/viirs/current/median-masked.tif
VIIRS_DATASET_YEAR=2024
VIIRS_DATASET_REVISION=eog-v2.2-2024-median-masked-r1
VIIRS_SOURCE_ID=eog-viirs-annual-v2.2
VIIRS_ATTRIBUTION=Earth Observation Group VIIRS annual nighttime lights
VIIRS_RESOLUTION_METERS=500
VIIRS_RASTER_SHA256=replace-with-64-lowercase-hex-sha256
LUMANEST_RASTER_SERVICE_URL=http://lumanest-raster-service:8792
LUMANEST_RASTER_SERVICE_TOKEN=replace-with-random-raster-token
LUMANEST_RASTER_DATASET_REVISION=eog-v2.2-2024-median-masked-r1

DEM_RASTER_HOST_DIR=/absolute/path/to/dem
DEM_RASTER_PATH=/data/dem/current/copernicus-glo30.tif
DEM_DATASET_REVISION=copernicus-glo30-2024-r1
DEM_SOURCE_ID=copernicus-dem-glo30
DEM_ATTRIBUTION=Copernicus DEM GLO-30
DEM_RESOLUTION_METERS=30
DEM_RASTER_SHA256=replace-with-64-lowercase-hex-sha256
LUMANEST_TERRAIN_SERVICE_URL=http://lumanest-terrain-service:8793
LUMANEST_TERRAIN_SERVICE_TOKEN=replace-with-random-terrain-token
LUMANEST_TERRAIN_DATASET_REVISION=copernicus-glo30-2024-r1

# Optional normalized Globe at Night / SQM calibration bundle. Leave empty until
# a provenance-reviewed bundle has been built and mounted read-only.
LUMANEST_SKY_BRIGHTNESS_CALIBRATION_PATH=

# Whole-backend outbound network mode. The admin console switches this value and
# recreates only the four application containers. Do not expose the controller
# token outside the NAS environment.
LUMANEST_OUTBOUND_NETWORK_MODE=direct
LUMANEST_OUTBOUND_PROXY_URL=
# Leave empty to let nas-deploy derive the BuildKit host-gateway URL from the
# runtime Mihomo URL. An explicit value must use host.docker.internal.
LUMANEST_BUILD_PROXY_URL=
LUMANEST_MIHOMO_PROXY_URL=http://mihomo:7890
LUMANEST_NETWORK_CONTROLLER_TOKEN=replace-with-random-32-byte-token
