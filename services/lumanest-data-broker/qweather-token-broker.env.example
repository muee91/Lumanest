# Copy to qweather-token-broker.env and replace every placeholder locally.
# Never commit the populated environment file.

QWEATHER_KEY_ID=replace-with-qweather-credential-id
QWEATHER_PROJECT_ID=replace-with-qweather-project-id
QWEATHER_API_HOST=https://replace-with-project-host.qweatherapi.com
QWEATHER_PRIVATE_KEY_FILE=/absolute/path/to/qweather-ed25519-private.pem

LUMANEST_SERVICE_TOKEN=replace-with-random-hex-token
AMAP_WEB_KEY=replace-with-amap-web-key
LUMANEST_CONFIG_MASTER_KEY=replace-with-base64-32-byte-key
LUMANEST_ADMIN_BOOTSTRAP_PASSWORD=replace-with-first-start-password
LUMANEST_ADMIN_PASSWORD=
LUMANEST_SIMULATION_ENABLED=false
LUMANEST_DATABASE_PASSWORD=replace-with-database-password

CONTEXT_INTERNAL_TOKEN=replace-with-random-context-token
DISCOVERY_INTERNAL_TOKEN=replace-with-random-discovery-token
DISCOVERY_WORKER_TOKEN=replace-with-random-worker-token

SUNSETBOT_BASE_URL=https://sunsetbot.top

# Whole-backend outbound network mode. The admin console switches this value and
# recreates only the four application containers. Do not expose the controller
# token outside the NAS environment.
LUMANEST_OUTBOUND_NETWORK_MODE=direct
LUMANEST_OUTBOUND_PROXY_URL=
LUMANEST_MIHOMO_PROXY_URL=http://mihomo:7890
LUMANEST_NETWORK_CONTROLLER_TOKEN=replace-with-random-32-byte-token
